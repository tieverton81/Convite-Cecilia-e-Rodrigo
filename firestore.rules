rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "ceciliaalves.rodrigocosta@gmail.com";
    }

    function shortString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function validReservation() {
      return request.resource.data.keys().hasOnly([
          "giftId",
          "giftTitle",
          "method",
          "guestName",
          "contact",
          "message",
          "status",
          "createdAt"
        ])
        && shortString(request.resource.data.giftId, 128)
        && shortString(request.resource.data.giftTitle, 160)
        && request.resource.data.giftTitle.size() > 0
        && request.resource.data.method in ["mercado_livre", "pessoalmente"]
        && shortString(request.resource.data.guestName, 120)
        && request.resource.data.guestName.size() > 0
        && shortString(request.resource.data.contact, 160)
        && shortString(request.resource.data.message, 500)
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;
    }

    function validPixContribution() {
      return request.resource.data.keys().hasOnly([
          "giftId",
          "giftTitle",
          "guestName",
          "amount",
          "message",
          "status",
          "createdAt"
        ])
        && shortString(request.resource.data.giftId, 128)
        && shortString(request.resource.data.giftTitle, 160)
        && request.resource.data.giftTitle.size() > 0
        && shortString(request.resource.data.guestName, 120)
        && request.resource.data.guestName.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && shortString(request.resource.data.message, 500)
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;
    }

    match /gifts/{giftId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{documentId} {
      allow read, write: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow create: if isAdmin() || validReservation();
      allow read, update, delete: if isAdmin();
    }

    match /pixContributions/{contributionId} {
      allow create: if isAdmin() || validPixContribution();
      allow read, update, delete: if isAdmin();
    }
  }
}
